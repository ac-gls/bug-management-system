# Optional tokens. Only needed if you'd rather not log in interactively - install.sh and
# scripts/authenticate.sh use `gh auth login` / `az login` when these are empty.
# Copy to configs/credentials.conf (gitignored) and keep it private (chmod 600).

GITHUB_TOKEN=""   # classic PAT with repo, read:org, project scopes
ADO_PAT=""        # Azure DevOps PAT with Work Items (Read & Write) scope
