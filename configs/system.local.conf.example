# Per-machine overrides for configs/system.conf. `./install.sh --configure` writes this file
# for you; to edit by hand, copy it to configs/system.local.conf (gitignored) and uncomment
# only what you need to change. Any setting in system.conf can be overridden here.

# APP_REPO_DIR="$HOME/code/bcx-app"
# APP_WORKTREE_DIR="$HOME/code/bcx-app-worktrees"
# MAX_PARALLEL_INVESTIGATIONS=2
